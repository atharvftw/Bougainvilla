# ─────────────────────────────────────────────────────────────
# Bougainvilla CRM — environment variables
#
# These are set in TWO places:
#   [n8n]    → n8n instance env vars (Settings → Variables, or docker-compose env)
#   [vercel] → Vercel project env vars (Project → Settings → Environment Variables)
#
# Copy to .env for local use. NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# ── Meta / WhatsApp / Instagram ──────────────────────────────  [n8n]
# App Dashboard → WhatsApp / Instagram → Configuration
META_VERIFY_TOKEN=              # you invent this string; paste the same one into Meta's "Verify token" box
META_APP_SECRET=                # App Dashboard → Settings → Basic → App Secret (REQUIRED: signs every webhook)
META_ACCESS_TOKEN=              # System User token, never a short-lived one
WHATSAPP_PHONE_NUMBER_ID=       # WhatsApp → API Setup → "Phone number ID"
INSTAGRAM_BUSINESS_ID=          # Instagram professional account ID (IGSID)

# ── Sarvam AI ────────────────────────────────────────────────  [n8n]
SARVAM_API_KEY=                 # dashboard.sarvam.ai → API keys
SARVAM_AGENT_CALLBACK_URL=      # where the voice agent expects its reply posted back
SARVAM_AGENT_API_KEY=

# ── PMS / channel manager (Hostaway, Guesty, Beds24, custom…) ─  [n8n]
PMS_API_KEY=
PMS_AVAILABILITY_URL=
PMS_PROPERTY_SEARCH_URL=
PMS_BOOKING_URL=
PMS_PRICING_DATA_URL=

# ── CRM ──────────────────────────────────────────────────────  [n8n]
CRM_API_KEY=
CRM_LEAD_URL=
CRM_FOLLOWUP_URL=
CRM_METRICS_URL=                # GET endpoint the dashboard reads its numbers from

# ── Support / ops ────────────────────────────────────────────  [n8n]
SUPPORT_API_KEY=
SUPPORT_TICKET_URL=
HUMAN_HANDOFF_URL=
STAFF_ALERT_API_KEY=
STAFF_ALERT_URL=

# ── Guest messaging (non-Meta fallback: SMS/RCS/other) ───────  [n8n]
MESSAGING_API_KEY=
GUEST_MESSAGING_URL=

# ── Reviews ──────────────────────────────────────────────────  [n8n]
REVIEW_API_KEY=
REVIEW_REPLY_URL=

# ── Revenue approval ─────────────────────────────────────────  [n8n]
APPROVAL_API_KEY=
PRICING_APPROVAL_URL=

# ── Dashboard ↔ n8n link ─────────────────────────────────────
DASHBOARD_API_KEY=              # [n8n] + [vercel] — shared secret, must match on both sides
N8N_DASHBOARD_URL=              # [vercel] https://<your-n8n>/webhook/bougainvilla-dashboard
