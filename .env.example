# ─────────────────────────────────────────────────────────────
# Bougainvilla CRM — environment variables
#
# This file is a CHECKLIST and the input to scripts/check-creds.mjs.
#
# n8n does NOT read it. That instance is Community Edition with no server
# access, so the workflow is configured through the n8n UI instead — see
# docs/n8n-config.md. The [n8n] tags below mean "this value is used by the
# workflow", not "set it as an environment variable".
#
# Only the [vercel] values are real environment variables, set in the Vercel
# project.
#
# Copy to .env for local use. NEVER commit the filled-in file.
# ─────────────────────────────────────────────────────────────

# ── Meta / Instagram ─────────────────────────────────────────  [n8n]
# App Dashboard → Instagram → Configuration
META_VERIFY_TOKEN=              # you invent this string; paste the same one into Meta's "Verify token" box
META_APP_SECRET=                # App Dashboard → Settings → Basic → App Secret (REQUIRED: signs every webhook)
META_ACCESS_TOKEN=              # System User token, never a short-lived one
INSTAGRAM_BUSINESS_ID=          # Instagram professional account ID (IGSID)

# ── Sarvam AI ────────────────────────────────────────────────  [n8n]
SARVAM_API_KEY=                 # dashboard.sarvam.ai → API keys
SARVAM_AGENT_CALLBACK_URL=      # where the voice agent expects its reply posted back
SARVAM_AGENT_API_KEY=

# ── Data store ───────────────────────────────────────────────  [n8n]
# Supabase is configured as an n8n *credential* (Credentials → Supabase API),
# not as env vars. Host + service_role key. See docs/supabase-setup.md.
#
# The PMS / CRM / support / messaging / review / approval endpoints are gone
# from here: those nodes hold plain URLs and their own n8n credentials, and
# the agent tools that used them ship disabled until a real backend exists.

# ── Dashboard ↔ n8n link ─────────────────────────────────────
DASHBOARD_API_KEY=              # [n8n] + [vercel] — shared secret, must match on both sides
N8N_DASHBOARD_URL=              # [vercel] https://<your-n8n>/webhook/bougainvilla-dashboard
